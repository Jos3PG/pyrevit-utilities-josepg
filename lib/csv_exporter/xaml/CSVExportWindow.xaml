<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CSV Export - Habitaciones y Áreas" 
        Height="720" Width="520"
        MinHeight="580" MinWidth="440"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="12"
        Background="#F4F4F6">

    <Window.Resources>
        <!-- Estilos para controles -->
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderBrush" Value="#D0D0D5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#222222"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="Background" Value="#EAEAEA"/>
            <Setter Property="BorderBrush" Value="#BBBBBB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <!-- Fila 0: Presets -->
            <RowDefinition Height="Auto"/>
            <!-- Fila 1: Selector de Categoría -->
            <RowDefinition Height="Auto"/>
            <!-- Fila 2: Parámetros a exportar (Expansible) -->
            <RowDefinition Height="*"/>
            <!-- Fila 3: Opciones de aspecto (captura) -->
            <RowDefinition Height="Auto"/>
            <!-- Fila 4: Opciones de salida (captura) -->
            <RowDefinition Height="Auto"/>
            <!-- Fila 5: Ubicación del archivo -->
            <RowDefinition Height="Auto"/>
            <!-- Fila 6: Botones de acción inferiores -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0. SECCIÓN PRESETS -->
        <GroupBox Grid.Row="0" Header="Presets de exportación">
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="cb_Presets" Grid.Column="0" Margin="0,0,6,0"/>
                <Button x:Name="btn_SavePreset" Grid.Column="1" Content="Guardar Preset" Margin="0,0,4,0" ToolTip="Guardar la configuración actual como preset"/>
                <Button x:Name="btn_DeletePreset" Grid.Column="2" Content="Eliminar" ToolTip="Eliminar el preset seleccionado"/>
            </Grid>
        </GroupBox>

        <!-- 1. SECCIÓN CATEGORÍA -->
        <GroupBox Grid.Row="1" Header="Elemento a exportar (Category)">
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Categoría:" Margin="0,0,10,0"/>
                <ComboBox x:Name="cb_Category" Grid.Column="1"/>
            </Grid>
        </GroupBox>

        <!-- 2. SECCIÓN PARÁMETROS -->
        <GroupBox Grid.Row="2" Header="Parámetros a exportar">
            <Grid Margin="0,4,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Barra de búsqueda y conteo -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="tb_SearchParam" Grid.Column="0" Height="25" VerticalContentAlignment="Center" 
                             ToolTip="Escribe para filtrar parámetros en tiempo real"/>
                    <TextBlock x:Name="lbl_ParamCount" Grid.Column="1" Text="0 seleccionados" Margin="8,0,0,0" 
                               FontWeight="Normal" Foreground="#555555"/>
                </Grid>

                <!-- Lista de parámetros con checkboxes -->
                <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="1" Background="#FFFFFF">
                    <ListBox x:Name="lb_Parameters" BorderThickness="0" Background="Transparent" 
                             ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </Border>

                <!-- Botones de selección rápida -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                    <Button x:Name="btn_SelectAll" Content="Seleccionar todos" Margin="0,0,6,0"/>
                    <Button x:Name="btn_DeselectAll" Content="Deseleccionar todos"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- 3. SECCIÓN ASPECTO (SCHEDULE APPEARANCE - SEGÚN CAPTURA) -->
        <GroupBox Grid.Row="3" Header="Schedule appearance">
            <StackPanel Margin="0,4,0,0">
                <CheckBox x:Name="chk_ExportTitle" Content="Export title" Margin="0,0,0,6" IsChecked="False"/>
                <CheckBox x:Name="chk_Headers" Content="Export column headers" Margin="0,0,0,6" IsChecked="True"/>
                <CheckBox x:Name="chk_ExcludeUnplaced" Content="Exclude unplaced / unbounded elements" IsChecked="True"/>
            </StackPanel>
        </GroupBox>

        <!-- 4. SECCIÓN OPCIONES DE SALIDA (OUTPUT OPTIONS - SEGÚN CAPTURA) -->
        <GroupBox Grid.Row="4" Header="Output options">
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Field delimiter:" Margin="0,0,10,6"/>
                <ComboBox x:Name="cb_Delimiter" Grid.Row="0" Grid.Column="1" Margin="0,0,0,6"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Text qualifier:" Margin="0,0,10,0"/>
                <ComboBox x:Name="cb_TextQualifier" Grid.Row="1" Grid.Column="1"/>
            </Grid>
        </GroupBox>

        <!-- 5. SECCIÓN UBICACIÓN DEL ARCHIVO -->
        <GroupBox Grid.Row="5" Header="Ubicación del CSV (Location of the CSV)">
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="tb_FilePath" Grid.Column="0" Height="26" VerticalContentAlignment="Center" Margin="0,0,6,0"/>
                <Button x:Name="btn_Browse" Grid.Column="1" Content="Examinar..."/>
            </Grid>
        </GroupBox>

        <!-- 6. BOTONES DE ACCIÓN INFERIORES -->
        <Grid Grid.Row="6" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="btn_Export" Grid.Column="1" Content="Exportar CSV" Width="110" Height="28" 
                    FontWeight="Bold" Background="#0078D7" Foreground="#FFFFFF" Margin="0,0,8,0"/>
            <Button x:Name="btn_Cancel" Grid.Column="2" Content="Cancelar" Width="85" Height="28"/>
        </Grid>
    </Grid>
</Window>
