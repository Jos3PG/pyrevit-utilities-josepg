<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CSV Export - Rooms &amp; Areas" 
        Height="720" Width="520"
        MinHeight="580" MinWidth="440"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="12"
        Background="#F4F4F6">

    <Window.Resources>
        <!-- Control styles -->
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderBrush" Value="#D0D0D5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#222222"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="Background" Value="#EAEAEA"/>
            <Setter Property="BorderBrush" Value="#BBBBBB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <!-- Row 0: Presets -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Category Selector -->
            <RowDefinition Height="Auto"/>
            <!-- Row 2: Parameters to Export (Expandable) -->
            <RowDefinition Height="*"/>
            <!-- Row 3: Schedule Appearance -->
            <RowDefinition Height="Auto"/>
            <!-- Row 4: Output Options -->
            <RowDefinition Height="Auto"/>
            <!-- Row 5: File Location -->
            <RowDefinition Height="Auto"/>
            <!-- Row 6: Bottom Action Buttons -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0. PRESETS SECTION -->
        <GroupBox Grid.Row="0" Header="Export Presets">
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="cb_Presets" Grid.Column="0" Margin="0,0,6,0"/>
                <Button x:Name="btn_SavePreset" Grid.Column="1" Content="Save" Margin="0,0,4,0" ToolTip="Save changes to current preset"/>
                <Button x:Name="btn_NewPreset" Grid.Column="2" Content="New" Margin="0,0,4,0" ToolTip="Create a new preset with current settings"/>
                <Button x:Name="btn_LoadPreset" Grid.Column="3" Content="Load" Margin="0,0,4,0" ToolTip="Reload saved settings for this preset"/>
                <Button x:Name="btn_DeletePreset" Grid.Column="4" Content="Delete" ToolTip="Delete selected preset"/>
            </Grid>
        </GroupBox>

        <!-- 1. CATEGORY SECTION -->
        <GroupBox Grid.Row="1" Header="Element Category to Export">
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Category:" Margin="0,0,10,0"/>
                <ComboBox x:Name="cb_Category" Grid.Column="1"/>
            </Grid>
        </GroupBox>

        <!-- 2. PARAMETERS SECTION -->
        <GroupBox Grid.Row="2" Header="Parameters to Export">
            <Grid Margin="0,4,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Search bar and counter -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="tb_SearchParam" Grid.Column="0" Height="25" VerticalContentAlignment="Center" 
                             ToolTip="Type to filter parameters in real-time"/>
                    <TextBlock x:Name="lbl_ParamCount" Grid.Column="1" Text="0 selected" Margin="8,0,0,0" 
                               FontWeight="Normal" Foreground="#555555"/>
                </Grid>

                <!-- Parameters list with checkboxes -->
                <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="1" Background="#FFFFFF">
                    <ListBox x:Name="lb_Parameters" BorderThickness="0" Background="Transparent" 
                             ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </Border>

                <!-- Quick selection buttons -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                    <Button x:Name="btn_SelectAll" Content="Select All" Margin="0,0,6,0"/>
                    <Button x:Name="btn_DeselectAll" Content="Deselect All"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- 3. SCHEDULE APPEARANCE SECTION -->
        <GroupBox Grid.Row="3" Header="Schedule Appearance">
            <StackPanel Margin="0,4,0,0">
                <CheckBox x:Name="chk_ExportTitle" Content="Export title" Margin="0,0,0,6" IsChecked="False"/>
                <CheckBox x:Name="chk_Headers" Content="Export column headers" Margin="0,0,0,6" IsChecked="True"/>
                <CheckBox x:Name="chk_IncludeLinks" Content="Include elements from Revit Links" Margin="0,0,0,6" IsChecked="True"/>
                <CheckBox x:Name="chk_ExcludeUnplaced" Content="Exclude unplaced / unbounded elements" IsChecked="True"/>
            </StackPanel>
        </GroupBox>

        <!-- 4. OUTPUT OPTIONS SECTION -->
        <GroupBox Grid.Row="4" Header="Output Options">
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Field delimiter:" Margin="0,0,10,6"/>
                <ComboBox x:Name="cb_Delimiter" Grid.Row="0" Grid.Column="1" Margin="0,0,0,6"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Text qualifier:" Margin="0,0,10,0"/>
                <ComboBox x:Name="cb_TextQualifier" Grid.Row="1" Grid.Column="1"/>
            </Grid>
        </GroupBox>

        <!-- 5. FILE LOCATION SECTION -->
        <GroupBox Grid.Row="5" Header="CSV File Location">
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="tb_FilePath" Grid.Column="0" Height="26" VerticalContentAlignment="Center" Margin="0,0,6,0"/>
                <Button x:Name="btn_Browse" Grid.Column="1" Content="Browse..."/>
            </Grid>
        </GroupBox>

        <!-- 6. BOTTOM ACTION BUTTONS -->
        <Grid Grid.Row="6" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="btn_Export" Grid.Column="1" Content="Export CSV" Width="110" Height="28" 
                    FontWeight="Bold" Background="#0078D7" Foreground="#FFFFFF" Margin="0,0,8,0"/>
            <Button x:Name="btn_Cancel" Grid.Column="2" Content="Cancel" Width="85" Height="28"/>
        </Grid>
    </Grid>
</Window>